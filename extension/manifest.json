{
  "manifest_version": 3,
  "name": "북마크 실시간 동기화",
  "version": "2.0.0",
  "description": "이 PC의 모든 Chrome 프로필 북마크를 공유 파일을 통해 맞춥니다(창을 전환할 때 반영).",
  "key": "",
  "permissions": ["bookmarks", "nativeMessaging", "storage", "unlimitedStorage", "alarms", "identity", "identity.email"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "북마크 동기화" }
}
